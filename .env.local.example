# ===========================================
# UFAS Cortex Environment Variables Template
# ===========================================
# Copy this file to .env.local and fill in the values
# Never commit .env.local to version control

# ----------
# Supabase
# ----------

# Your Supabase project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for client-side, found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-side only, found in Project Settings > API)
# WARNING: Never expose this key to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database connection string (for migrations, found in Project Settings > Database)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ----------
# OAuth Providers (Optional for Development)
# ----------

# Google OAuth (https://console.cloud.google.com)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Microsoft OAuth (https://portal.azure.com)
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ----------
# AI Configuration
# ----------

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI model to use (gpt-4-turbo-preview recommended)
OPENAI_MODEL=gpt-4-turbo-preview

# ----------
# Application
# ----------

# Your application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, production)
NODE_ENV=development

# ----------
# Feature Flags (Optional)
# ----------

# Enable/disable features
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
NEXT_PUBLIC_ENABLE_COMMUNITY_FEATURES=true
NEXT_PUBLIC_ENABLE_SEARCH=true

# ----------
# Storage Configuration
# ----------

# Maximum file upload size in bytes (default: 50MB)
NEXT_PUBLIC_MAX_FILE_SIZE=52428800

# Allowed file types (MIME types, comma-separated)
NEXT_PUBLIC_ALLOWED_FILE_TYPES=application/pdf

# ----------
# Rate Limiting (Optional)
# ----------

RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=100
RATE_LIMIT_AI_PER_HOUR=20
RATE_LIMIT_DOWNLOADS_PER_HOUR=50

# ----------
# Analytics (Optional)
# ----------

# Sentry error tracking
NEXT_PUBLIC_SENTRY_DSN=https://xxx@sentry.io/xxx
SENTRY_AUTH_TOKEN=your-sentry-auth-token
